# GEMINI_API free key 
GEMINI_API_KEY=

# AI MODELS
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Application Settings ---
APP_ENV=development
DEBUG=True

# --- Kafka Settings ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SENSOR_DATA=factory.sensor.raw

# --- Database Settings (TimescaleDB / PostgreSQL) ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_factory

# ---
ENABLE_VIRTUAL_DATA=false      # fake data on/off
ENABLE_RUL_SERVICE=true

# --data file path
CMAPSS_DATA_DIR=C:/factory_pdm_data/cmapss
IMS_DATA_DIR=C:/factory_pdm_data/2nd_test
CWRU_DATA_DIR=C:/factory_pdm_data/cwru
